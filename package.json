{
  "name": "elven-unified-observability-js",
  "version": "1.2.0",
  "description": "Unified wrapper for logs and telemetry instrumentation",
  "sideEffects": [
    "./dist/register.js"
  ],
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "MEMORY_TUNING.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "require": "./dist/register.js",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/**/*.test.cjs",
    "validate:candidate": "node scripts/validate-candidate.cjs",
    "package:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "node scripts/verify-public-lock.cjs && npm run typecheck && npm test && npm run package:check"
  },
  "keywords": [
    "observability",
    "logs",
    "telemetry",
    "opentelemetry"
  ],
  "author": "Leonardo Zwirtes",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elven-observability/elven-unified-observability-js.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "elven-opentelemetry-instrumentation-js": "2.0.0-rc.1",
    "elven-logs-interceptor": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.6.0 || ^22.0.0 || ^24.0.0 || >=26.0.0"
  }
}
